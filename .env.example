# PayrollPH environment. deploy/deploy.sh copies this to .env on first run and
# fills the secrets with `openssl rand`. Never commit .env.

# Public hostname served by aaPanel's reverse proxy (used in links and cookies)
DOMAIN=payroll.example.com
# Pre-filled into the setup wizard
ADMIN_EMAIL=owner@example.com

# PostgreSQL
POSTGRES_USER=payrollph
POSTGRES_DB=payrollph
POSTGRES_PASSWORD=change-me
# Host port for local development only (docker-compose.override.yml)
DB_PORT=5432

# 32 random bytes as 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=
# At least 32 chars: openssl rand -hex 32
SESSION_SECRET=

TZ=Asia/Manila

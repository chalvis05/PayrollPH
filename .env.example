# PayrollPH environment. deploy/deploy.sh copies this to .env on first run and fills the
# secrets with `openssl rand`. Never commit .env. Never change ENCRYPTION_KEY after first use:
# encrypted government IDs and account numbers could no longer be read.

# Public hostname served by aaPanel's reverse proxy
DOMAIN=payroll.example.com
# Pre-filled into the setup wizard
ADMIN_EMAIL=owner@example.com

# PostgreSQL 18. Production: the server's own PostgreSQL (create this role and database first;
# see deploy/README.md). Local development: the db container in docker-compose.override.yml.
POSTGRES_USER=payrollph
POSTGRES_DB=payrollph
POSTGRES_PASSWORD=change-me
# Port of the server's PostgreSQL (production) or the dev container's published port (local).
DB_PORT=5432
# Containers reach the server's PostgreSQL at host.docker.internal by default. Local scripts
# (pnpm migrate/seed/dev) use localhost. Uncomment only to override both.
# DB_HOST=host.docker.internal

# 32 random bytes as 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=
# At least 32 chars: openssl rand -hex 32
SESSION_SECRET=

# Host port the web container is published on (127.0.0.1 only; aaPanel proxies to it)
WEB_PORT=8080
# Session cookies are Secure in production (HTTPS via aaPanel). Set to false only for a
# plain-HTTP test install.
# COOKIE_SECURE=true

TZ=Asia/Manila
